{
  "name": "social-analytics-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --local-protocol https",
    "check": "pnpm typegen:check && pnpm format:check && pnpm status-counters:check && pnpm boundaries:check && pnpm typecheck && pnpm test && pnpm deploy:dry-run",
    "typegen": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars false",
    "typegen:check": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars false --check",
    "format": "biome check --write . ../scripts ../package.json",
    "format:check": "biome check . ../scripts ../package.json",
    "boundaries:check": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply social-analytics-db --local",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "status-counters:check": "node scripts/status-counters-sql.mjs migrations/0016_great_firedrake.sql --check"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
